{
  "name": "youtube-webos",
  "version": "0.8.5",
  "description": "Ad-free YouTube app for webOS",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "webpack --mode=production",
    "build:modern": "webpack --mode=production --env modern",
    "build:perf": "webpack --mode=production --env perf",
    "build:perf:modern": "webpack --mode=production --env modern --env perf",
    "build:dev": "webpack --mode=development",
    "build:dev:inspect": "npm run build:dev && npm run package && npm run deploy && npm run inspect",
    "package": "ares-package -n dist -o dist",
    "deploy": "node tools/deploy.js",
    "inspect": "ares-inspect youtube.leanback.v4",
    "launch": "ares-launch youtube.leanback.v4",
    "manifest": "node tools/gen-manifest.cjs youtube.leanback.v4.manifest.json",
    "version": "node tools/sync-version.cjs && git add assets/appinfo.json",
    "lint": "eslint",
    "typecheck": "tsc -p tsconfig.json",
    "type-check": "npm run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prettier-check": "npm run format:check",
    "test": "node tests/run-all.mjs",
    "test:quick": "node tests/run-all.mjs --quick",
    "bench": "npm run build && node tests/bench/hook-bench.cjs && node tests/bench/panel-bench.cjs",
    "bundle:snapshot": "node tools/bundle-snapshot.mjs snapshot",
    "bundle:compare": "node tools/bundle-snapshot.mjs compare",
    "codemap": "node tools/codemap.mjs",
    "codemap:check": "node tools/codemap.mjs --check"
  },
  "license": "GPL-3.0-only",
  "repository": "github:webosbrew/youtube-webos",
  "bugs": "https://github.com/NicholasBly/youtube-webos/issues",
  "homepage": "https://github.com/NicholasBly/youtube-webos#readme",
  "dependencies": {
    "@babel/runtime": "8.0.7",
    "@twemoji/api": "16.0.1",
    "tiny-sha256": "1.0.2",
    "whatwg-fetch": "3.6.20"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/plugin-transform-runtime": "^8.0.6",
    "@babel/plugin-transform-typescript": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@webos-tools/cli": "^3.2.6",
    "acorn": "^8.19.0",
    "autoprefixer": "^10.6.1",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "cssnano": "^9.3.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-regexp": "^3.3.1",
    "globals": "^17.13.0",
    "jsdom": "30.1.2",
    "postcss": "^8.5.29",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.9.9",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "~6.0.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26"
  }
}
